# Vollständige Referenz aller Umgebungsvariablen (Werte bewusst leer).
# Lokal: Kopie als .env.local anlegen. Produktion (Strato): Werte stehen in
# /etc/lernsprung/.env.production (siehe docs/deployment-strato.md) – NIE im Repo.
# Keine der Variablen unten darf NEXT_PUBLIC_ heißen, außer den ausdrücklich so
# benannten (die landen im Browser-Bundle).

# --- Admin ---
# PIN für den Admin-Bereich (/admin), wird bei jeder Admin-API-Anfrage serverseitig geprüft
ADMIN_PIN=

# --- MongoDB ---
# Verbindungsstring (z.B. MongoDB Atlas: mongodb+srv://<user>:<passwort>@<cluster>.mongodb.net)
MONGODB_URI=
# Datenbankname (wird automatisch angelegt)
MONGODB_DB=nachhilfe

# --- Stripe (bleibt bis zur separaten Ablösung unverändert) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Öffentliche Basis-URL der Website (Stripe-Rücksprünge, Meeting-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-Mail-Versand (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absenderadresse (Standard: SMTP_USER)
SMTP_FROM=

# --- Rechnungsstellung (E-Rechnung / ZUGFeRD + GiroCode) ---
# Rechnungssteller, so wie er auf der Rechnung erscheinen soll (§ 14 UStG:
# vollständiger Name + Anschrift). Bei Einzelunternehmen: "Lernsprung – Inhaber: Vorname Nachname"
INVOICE_SELLER_NAME=
INVOICE_SELLER_STREET=
INVOICE_SELLER_ZIP=
INVOICE_SELLER_CITY=
# Kontaktangaben auf der Rechnung und in der Rechnungsmail
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
# Steuerangaben – BEIDE optional und standardmäßig leer.
#
# WICHTIG: Hier gehört NIEMALS die persönliche Steuer-Identifikationsnummer
# nach § 139b AO hinein (11 Ziffern, Format 12 345 678 901). Sie ist ein
# lebenslanges Personenkennzeichen ausschließlich für den Verkehr mit
# Finanzbehörden und darf weder auf einer Rechnung noch im ZUGFeRD-XML noch im
# Impressum auftauchen.
#
# Steuernummer, wie sie das Finanzamt für den Betrieb vergeben hat
# (Format z.B. 12/345/67890). Nur ausfüllen, wenn tatsächlich vergeben.
INVOICE_TAX_NUMBER=
# USt-IdNr. mit Länderpräfix (z.B. DE123456789). Bei Kleinunternehmerregelung
# nach § 19 UStG gibt es keine – dann leer lassen.
INVOICE_VAT_ID=
# Bankverbindung für Überweisung und GiroCode
INVOICE_IBAN=
# BIC ist bei Inlandsüberweisungen optional (im GiroCode darf die Zeile leer bleiben)
INVOICE_BIC=
# Kontoinhaber:in exakt wie bei der Bank hinterlegt (max. 70 Zeichen)
INVOICE_ACCOUNT_HOLDER=
# Nummernformat: {YYYY} = Jahr (Zähler startet jedes Jahr neu), {NNNN} = laufende Nummer
# mit Mindeststellen. Nach der ersten ausgestellten Rechnung NICHT mehr ändern.
INVOICE_NUMBER_FORMAT=LS-{YYYY}-{NNNN}
# Zahlungsziel in Tagen ab Rechnungsdatum
INVOICE_PAYMENT_TERM_DAYS=14
# Ablageort der ausgestellten PDFs (absolut oder relativ zum Projektordner). Muss
# außerhalb von public/ liegen und ins Backup einbezogen werden. Produktion z.B.
# /var/lib/lernsprung/invoices (Rechte: nur der deploy-User).
INVOICE_STORAGE_PATH=data/invoices

# --- Suchmaschinen (optional) ---
# Link zum Google-Unternehmensprofil (https://…). Erscheint als "sameAs" in den
# strukturierten Daten der Startseite. Leer lassen, solange es kein Profil gibt.
GOOGLE_PROFIL_URL=
# Nur falls die Search Console per Meta-Tag statt per DNS bestätigt wird:
# den Code oder das komplette <meta name="google-site-verification" …>-Tag.
SEARCH_CONSOLE_META_TAG=
