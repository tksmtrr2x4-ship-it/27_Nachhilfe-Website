# PIN für den Admin-Bereich (/admin) – frei wählbar, unbedingt ändern
ADMIN_PIN=change-me

# --- MongoDB ---
# Verbindungsstring, z.B. von MongoDB Atlas:
# mongodb+srv://<user>:<passwort>@<cluster>.xxxxx.mongodb.net
MONGODB_URI=
# Name der Datenbank (wird bei Bedarf automatisch angelegt)
MONGODB_DB=nachhilfe

# --- Stripe ---
# API-Keys aus dem Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Testmodus: sk_test_... / pk_test_...   |   Live: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing Secret des Webhook-Endpoints (Dashboard -> Developers -> Webhooks),
# beginnt mit whsec_... – lokal via `stripe listen` erhältlich
STRIPE_WEBHOOK_SECRET=

# Öffentliche Basis-URL der Website (für die Stripe-Rücksprünge).
# Lokal http://localhost:3000, in Produktion z.B. https://deine-domain.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-Mail-Versand (SMTP, z.B. über ein Gmail-Konto) ---
# Bei Gmail: smtp.gmail.com, Port 587. SMTP_USER = volle Gmail-Adresse,
# SMTP_PASS = ein App-Passwort (kein normales Kontopasswort, siehe README).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absenderadresse in den verschickten Mails (Standard: SMTP_USER)
SMTP_FROM=
