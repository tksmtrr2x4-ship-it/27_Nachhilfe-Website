<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nach ~/Library/LaunchAgents/ kopieren, BENUTZERNAME ersetzen (siehe docs/datenbank-backup.md). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.lernsprung.backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/BENUTZERNAME/.local/bin/lernsprung-backup-pull.sh</string>
  </array>
  <!-- Stündlich zur Minute 20. Anders als StartInterval holt launchd verpasste
       Kalender-Termine nach dem Aufwachen nach (Laptop schläft nachts). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/BENUTZERNAME/Backups/Lernsprung/pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/BENUTZERNAME/Backups/Lernsprung/pull.log</string>
</dict>
</plist>
